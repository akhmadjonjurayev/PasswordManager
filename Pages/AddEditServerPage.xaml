<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PasswordManager.Pages.AddEditServerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource Scrim}"
    NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Dialog card -->
        <Border Style="{StaticResource Card}"
                WidthRequest="600"
                HorizontalOptions="Center" VerticalOptions="Center"
                Margin="24" Padding="0"
                StrokeShape="RoundRectangle 20">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.22" Radius="40" Offset="0,12" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="28,24,20,12">
                    <Border Style="{StaticResource Tile}" BackgroundColor="{DynamicResource AccentSoft}">
                        <Label Style="{StaticResource Glyph}" Text="&#xE968;" FontSize="18" TextColor="{DynamicResource AccentOnSoft}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label x:Name="PageTitleLabel" Text="Yangi server qo'shish" FontSize="20" FontAttributes="Bold"
                               FontFamily="{StaticResource DisplayFont}" />
                        <Label Text="Login, parol va izoh shifrlangan holda saqlanadi" FontSize="13"
                               TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="&#xE711;" Style="{StaticResource IconButton}"
                            VerticalOptions="Start" Clicked="OnCancel_Clicked" ToolTipProperties.Text="Yopish" />
                </Grid>

                <!-- Form -->
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="28,8,28,8" Spacing="16">

                        <VerticalStackLayout Spacing="0">
                            <Label Text="Server nomi *" Style="{StaticResource FieldLabel}" />
                            <Border x:Name="NameField" Style="{StaticResource Field}">
                                <Entry x:Name="NameEntry" Placeholder="Masalan: Asosiy web server" ReturnType="Next" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="2*,*" ColumnSpacing="14">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Host / IP manzil *" Style="{StaticResource FieldLabel}" />
                                <Border x:Name="HostField" Style="{StaticResource Field}">
                                    <Entry x:Name="HostEntry" Placeholder="192.168.1.1 yoki server.example.com"
                                           FontFamily="{StaticResource MonoFont}" ReturnType="Next" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                <Label Text="Port" Style="{StaticResource FieldLabel}" />
                                <Border x:Name="PortField" Style="{StaticResource Field}">
                                    <Entry x:Name="PortEntry" Placeholder="22" Keyboard="Numeric"
                                           FontFamily="{StaticResource MonoFont}" ReturnType="Next" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Server turi" Style="{StaticResource FieldLabel}" />
                                <Border x:Name="TypeField" Style="{StaticResource Field}">
                                    <Picker x:Name="TypePicker" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                <Label Text="Foydalanuvchi nomi" Style="{StaticResource FieldLabel}" />
                                <Border x:Name="UsernameField" Style="{StaticResource Field}">
                                    <Entry x:Name="UsernameEntry" Placeholder="root, admin, ubuntu..."
                                           FontFamily="{StaticResource MonoFont}" ReturnType="Next" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="0">
                            <Label Text="Parol / kalit" Style="{StaticResource FieldLabel}" />
                            <Border x:Name="PasswordField" Style="{StaticResource Field}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry x:Name="PasswordEntry" Placeholder="Parol yoki SSH kalit"
                                           FontFamily="{StaticResource MonoFont}"
                                           IsPassword="True" ReturnType="Next" />
                                    <Button Grid.Column="1" x:Name="TogglePwBtn" Text="&#xE890;"
                                            Style="{StaticResource IconButton}"
                                            Clicked="OnTogglePassword_Clicked" ToolTipProperties.Text="Ko'rsatish / yashirish" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="0">
                            <Label Text="Izoh" Style="{StaticResource FieldLabel}" />
                            <Border x:Name="NotesField" Style="{StaticResource Field}" Padding="10,6">
                                <Editor x:Name="NotesEditor"
                                        Placeholder="Server haqida qo'shimcha ma'lumot..."
                                        MinimumHeightRequest="80"
                                        AutoSize="TextChanges" />
                            </Border>
                        </VerticalStackLayout>

                        <Border x:Name="ErrorBox" IsVisible="False"
                                BackgroundColor="{DynamicResource DangerSoft}" Stroke="{DynamicResource DangerBorder}"
                                StrokeShape="RoundRectangle 12" Padding="14,10">
                            <HorizontalStackLayout Spacing="10">
                                <Label Style="{StaticResource Glyph}" Text="&#xE7BA;" TextColor="{DynamicResource Danger}" />
                                <Label x:Name="ErrorLabel" Text="" FontAttributes="Bold" TextColor="{DynamicResource Danger}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Footer -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="28,16,28,24">
                    <BoxView Grid.ColumnSpan="3" HeightRequest="1" VerticalOptions="Start" Margin="-28,-16,-28,0"
                             Color="{DynamicResource Border}" />
                    <Label Text="* majburiy maydonlar" FontSize="12" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Bekor qilish" Style="{StaticResource SecondaryButton}" Clicked="OnCancel_Clicked" />
                    <Button Grid.Column="2" x:Name="SaveButton" Text="Saqlash" Style="{StaticResource PrimaryButton}"
                            MinimumWidthRequest="120" Clicked="OnSave_Clicked" />
                </Grid>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay" IsVisible="False" BackgroundColor="{DynamicResource Scrim}">
            <ActivityIndicator IsRunning="True" WidthRequest="48" HeightRequest="48"
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PasswordManager.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">

    <Grid x:Name="RootGrid" ColumnDefinitions="*,*">

        <!-- ═══ Brand panel (hidden on narrow windows) ═══ -->
        <Grid x:Name="BrandPanel"
              Grid.Column="0"
              BackgroundColor="{DynamicResource LoginPanel}"
              IsClippedToBounds="True"
              RowDefinitions="Auto,*,Auto"
              Padding="56,48">

            <!-- Decorative rounded squares around a shield -->
            <Grid Grid.RowSpan="3"
                  HorizontalOptions="End"
                  VerticalOptions="Center"
                  WidthRequest="520" HeightRequest="520"
                  TranslationX="176"
                  InputTransparent="True">
                <Border WidthRequest="520" HeightRequest="520"
                        StrokeShape="RoundRectangle 120"
                        Stroke="{DynamicResource LoginPanelLine}" StrokeThickness="1"
                        BackgroundColor="Transparent" />
                <Border WidthRequest="360" HeightRequest="360"
                        StrokeShape="RoundRectangle 88"
                        Stroke="{DynamicResource LoginPanelLine}" StrokeThickness="1"
                        BackgroundColor="Transparent" />
                <Border WidthRequest="200" HeightRequest="200"
                        StrokeShape="RoundRectangle 56"
                        StrokeThickness="0"
                        BackgroundColor="{DynamicResource LoginPanelFill}">
                    <Image Source="logo_mark.png" WidthRequest="96" HeightRequest="96" />
                </Border>
            </Grid>

            <HorizontalStackLayout Grid.Row="0" Spacing="10">
                <Image Source="logo_mark.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                <Label Text="SecureVault" FontSize="18" FontAttributes="Bold"
                       FontFamily="{StaticResource DisplayFont}"
                       TextColor="{DynamicResource LoginPanelText}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="16"
                                 MaximumWidthRequest="460" HorizontalOptions="Start">
                <Label Text="Parollaringiz bir joyda, shifrlangan holda."
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="40" FontAttributes="Bold" LineHeight="1.1"
                       TextColor="{DynamicResource LoginPanelText}" />
                <Label Text="Hech narsa internetga chiqmaydi — ombor faqat shu kompyuterda saqlanadi."
                       FontSize="16" LineHeight="1.3"
                       TextColor="{DynamicResource LoginPanelMuted}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2" Spacing="12">
                <HorizontalStackLayout Spacing="10">
                    <Label Style="{StaticResource Glyph}" Text="&#xE73E;" TextColor="{DynamicResource LoginPanelText}" />
                    <Label Text="AES-256 shifrlash, har bir yozuvga alohida IV" FontAttributes="Bold"
                           TextColor="{DynamicResource LoginPanelText}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="10">
                    <Label Style="{StaticResource Glyph}" Text="&#xE73E;" TextColor="{DynamicResource LoginPanelText}" />
                    <Label Text="PBKDF2-SHA512, 310 000 iteratsiya" FontAttributes="Bold"
                           TextColor="{DynamicResource LoginPanelText}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="10">
                    <Label Style="{StaticResource Glyph}" Text="&#xE73E;" TextColor="{DynamicResource LoginPanelText}" />
                    <Label Text="10 daqiqa harakatsizlikdan so'ng avto-qulf" FontAttributes="Bold"
                           TextColor="{DynamicResource LoginPanelText}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- ═══ Form side ═══ -->
        <Grid Grid.Column="1" BackgroundColor="{DynamicResource Surface}">

            <ScrollView VerticalScrollBarVisibility="Default">
                <Grid MinimumHeightRequest="600" Padding="24,48">
                    <VerticalStackLayout x:Name="FormStack"
                                         WidthRequest="400"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="0">

                        <Border x:Name="AvatarBorder"
                                WidthRequest="56" HeightRequest="56"
                                StrokeShape="RoundRectangle 28" StrokeThickness="0"
                                BackgroundColor="{DynamicResource AccentSoft}"
                                HorizontalOptions="Start"
                                Margin="0,0,0,20">
                            <Label x:Name="InitialsLabel"
                                   Text="&#xE8D7;"
                                   FontSize="18" FontAttributes="Bold"
                                   TextColor="{DynamicResource AccentOnSoft}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Label x:Name="TitleLabel"
                               Text="Xush kelibsiz"
                               Style="{StaticResource Heading}"
                               FontSize="28" />
                        <Label x:Name="SubtitleLabel"
                               Text="Omborni ochish uchun asosiy parolingizni kiriting."
                               Style="{StaticResource Subheading}"
                               Margin="0,6,0,28" />

                        <!-- ── First-time setup ── -->
                        <VerticalStackLayout x:Name="SetupSection" IsVisible="False" Spacing="0">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,16">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="Ism" Style="{StaticResource FieldLabel}" />
                                    <Border x:Name="FirstNameField" Style="{StaticResource Field}">
                                        <Entry x:Name="FirstNameEntry" Placeholder="Ismingiz" ReturnType="Next" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Familiya" Style="{StaticResource FieldLabel}" />
                                    <Border x:Name="LastNameField" Style="{StaticResource Field}">
                                        <Entry x:Name="LastNameEntry" Placeholder="Familiyangiz" ReturnType="Next" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="Asosiy parol yarating" Style="{StaticResource FieldLabel}" />
                            <Border x:Name="SetupPasswordField" Style="{StaticResource Field}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry x:Name="SetupPasswordEntry"
                                           Placeholder="Kamida 8 ta belgi"
                                           IsPassword="True"
                                           ReturnType="Next"
                                           TextChanged="OnPasswordChanged" />
                                    <Button Grid.Column="1"
                                            Text="&#xE890;"
                                            Style="{StaticResource IconButton}"
                                            Clicked="OnTogglePasswordVisibility"
                                            CommandParameter="setup"
                                            ToolTipProperties.Text="Ko'rsatish / yashirish" />
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4" Margin="0,10,0,6">
                                <BoxView x:Name="Strength1" Grid.Column="0" HeightRequest="6" CornerRadius="3" Color="{DynamicResource StrengthEmpty}" />
                                <BoxView x:Name="Strength2" Grid.Column="1" HeightRequest="6" CornerRadius="3" Color="{DynamicResource StrengthEmpty}" />
                                <BoxView x:Name="Strength3" Grid.Column="2" HeightRequest="6" CornerRadius="3" Color="{DynamicResource StrengthEmpty}" />
                                <BoxView x:Name="Strength4" Grid.Column="3" HeightRequest="6" CornerRadius="3" Color="{DynamicResource StrengthEmpty}" />
                            </Grid>
                            <Label x:Name="StrengthLabel" Text=" " FontSize="12" FontAttributes="Bold" Margin="0,0,0,16" />

                            <Label Text="Parolni tasdiqlang" Style="{StaticResource FieldLabel}" />
                            <Border x:Name="ConfirmPasswordField" Style="{StaticResource Field}" Margin="0,0,0,24">
                                <Entry x:Name="ConfirmPasswordEntry"
                                       Placeholder="Parolni qayta kiriting"
                                       IsPassword="True"
                                       ReturnType="Done"
                                       Completed="OnActionButtonClicked" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- ── Login ── -->
                        <VerticalStackLayout x:Name="LoginSection" Spacing="0">
                            <Label Text="Asosiy parol" Style="{StaticResource FieldLabel}" />
                            <Border x:Name="LoginPasswordField" Style="{StaticResource Field}" MinimumHeightRequest="50">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry x:Name="LoginPasswordEntry"
                                           Placeholder="Parolni kiriting"
                                           FontSize="15"
                                           IsPassword="True"
                                           ReturnType="Done"
                                           Completed="OnActionButtonClicked" />
                                    <Button Grid.Column="1"
                                            Text="&#xE890;"
                                            Style="{StaticResource IconButton}"
                                            Clicked="OnTogglePasswordVisibility"
                                            CommandParameter="login"
                                            ToolTipProperties.Text="Ko'rsatish / yashirish" />
                                </Grid>
                            </Border>
                            <Label Text="Enter tugmasini bosib ham ochishingiz mumkin"
                                   FontSize="12" TextColor="{DynamicResource TextMuted}"
                                   Margin="0,8,0,24" />
                        </VerticalStackLayout>

                        <!-- Error -->
                        <Border x:Name="ErrorBox"
                                IsVisible="False"
                                BackgroundColor="{DynamicResource DangerSoft}"
                                Stroke="{DynamicResource DangerBorder}"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,10"
                                Margin="0,0,0,16">
                            <HorizontalStackLayout Spacing="10">
                                <Label Style="{StaticResource Glyph}" Text="&#xE7BA;" TextColor="{DynamicResource Danger}" />
                                <Label x:Name="ErrorLabel" Text="" TextColor="{DynamicResource Danger}"
                                       FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Grid>
                            <Button x:Name="ActionButton"
                                    Text="Omborni ochish"
                                    Style="{StaticResource PrimaryButton}"
                                    HeightRequest="48"
                                    FontSize="15"
                                    Clicked="OnActionButtonClicked" />
                            <ActivityIndicator x:Name="LoadingIndicator"
                                               IsRunning="False" IsVisible="False"
                                               Color="{DynamicResource OnAccent}"
                                               WidthRequest="22" HeightRequest="22"
                                               HorizontalOptions="End" Margin="0,0,16,0"
                                               InputTransparent="True" />
                        </Grid>

                        <Border BackgroundColor="{DynamicResource SurfaceAlt}"
                                Stroke="{DynamicResource Border}"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,12"
                                Margin="0,28,0,0">
                            <HorizontalStackLayout Spacing="10">
                                <Label Style="{StaticResource Glyph}" Text="&#xE946;" />
                                <Label Text="Asosiy parolni unutsangiz, uni tiklab bo'lmaydi."
                                       FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>

            <!-- Theme switch -->
            <Button x:Name="ThemeButton"
                    Style="{StaticResource IconButtonOutline}"
                    HorizontalOptions="End" VerticalOptions="Start"
                    Margin="24"
                    Clicked="OnToggleTheme_Clicked"
                    ToolTipProperties.Text="Oq / qora fon" />
        </Grid>
    </Grid>

</ContentPage>

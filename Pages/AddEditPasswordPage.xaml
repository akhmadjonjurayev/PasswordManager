<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PasswordManager.Pages.AddEditPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource Scrim}"
    NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Dialog card -->
        <Border Style="{StaticResource Card}"
                WidthRequest="600"
                HorizontalOptions="Center" VerticalOptions="Center"
                Margin="24" Padding="0"
                StrokeShape="RoundRectangle 20">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.22" Radius="40" Offset="0,12" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="28,24,20,12">
                    <Border Style="{StaticResource Tile}" BackgroundColor="{DynamicResource AccentSoft}">
                        <Label Style="{StaticResource Glyph}" Text="&#xE8D7;" FontSize="18" TextColor="{DynamicResource AccentOnSoft}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label x:Name="PageTitleLabel" Text="Yangi parol qo'shish" FontSize="20" FontAttributes="Bold"
                               FontFamily="{StaticResource DisplayFont}" />
                        <Label Text="Barcha ma'lumotlar shifrlangan holda saqlanadi" FontSize="13"
                               TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="&#xE711;" Style="{StaticResource IconButton}"
                            VerticalOptions="Start" Clicked="OnCancel_Clicked" ToolTipProperties.Text="Yopish" />
                </Grid>

                <!-- Form -->
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="28,8,28,8" Spacing="16">

                        <VerticalStackLayout Spacing="0">
                            <Label Text="Xizmat nomi *" Style="{StaticResource FieldLabel}" />
                            <Border x:Name="ServiceField" Style="{StaticResource Field}">
                                <Entry x:Name="ServiceEntry" Placeholder="Google, GitHub, Telegram..." ReturnType="Next" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="0">
                            <Label Text="Parol *" Style="{StaticResource FieldLabel}" />
                            <Border x:Name="PasswordField" Style="{StaticResource Field}">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <Entry x:Name="PasswordEntry"
                                           Placeholder="Parolni kiriting yoki yarating"
                                           FontFamily="{StaticResource MonoFont}"
                                           IsPassword="True"
                                           ReturnType="Next"
                                           TextChanged="OnPasswordTextChanged" />
                                    <Button Grid.Column="1" x:Name="TogglePwBtn" Text="&#xE890;"
                                            Style="{StaticResource IconButton}"
                                            Clicked="OnTogglePassword_Clicked" ToolTipProperties.Text="Ko'rsatish / yashirish" />
                                    <Button Grid.Column="2" Text="&#xE945;"
                                            Style="{StaticResource IconButton}"
                                            TextColor="{DynamicResource Accent}"
                                            Clicked="OnQuickGenerate_Clicked" ToolTipProperties.Text="Kuchli parol yaratish" />
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4" Margin="0,10,0,6">
                                <BoxView x:Name="PwStrength1" Grid.Column="0" HeightRequest="6" CornerRadius="3" Color="{DynamicResource StrengthEmpty}" />
                                <BoxView x:Name="PwStrength2" Grid.Column="1" HeightRequest="6" CornerRadius="3" Color="{DynamicResource StrengthEmpty}" />
                                <BoxView x:Name="PwStrength3" Grid.Column="2" HeightRequest="6" CornerRadius="3" Color="{DynamicResource StrengthEmpty}" />
                                <BoxView x:Name="PwStrength4" Grid.Column="3" HeightRequest="6" CornerRadius="3" Color="{DynamicResource StrengthEmpty}" />
                            </Grid>
                            <Label x:Name="PwStrengthLabel" Text=" " FontSize="12" FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Papka" Style="{StaticResource FieldLabel}" />
                                <Border x:Name="FolderField" Style="{StaticResource Field}">
                                    <Picker x:Name="FolderPicker" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                <Label Text="Foydalanuvchi nomi" Style="{StaticResource FieldLabel}" />
                                <Border x:Name="UsernameField" Style="{StaticResource Field}">
                                    <Entry x:Name="UsernameEntry" Placeholder="Login" ReturnType="Next" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Email" Style="{StaticResource FieldLabel}" />
                                <Border x:Name="EmailField" Style="{StaticResource Field}">
                                    <Entry x:Name="EmailEntry" Placeholder="email@misol.com" Keyboard="Email" ReturnType="Next" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="0">
                                <Label Text="Telefon" Style="{StaticResource FieldLabel}" />
                                <Border x:Name="PhoneField" Style="{StaticResource Field}">
                                    <Entry x:Name="PhoneEntry" Placeholder="+998 90 123 45 67" Keyboard="Telephone"
                                           ReturnType="Done" Completed="OnSave_Clicked" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Border x:Name="ErrorBox" IsVisible="False"
                                BackgroundColor="{DynamicResource DangerSoft}" Stroke="{DynamicResource DangerBorder}"
                                StrokeShape="RoundRectangle 12" Padding="14,10">
                            <HorizontalStackLayout Spacing="10">
                                <Label Style="{StaticResource Glyph}" Text="&#xE7BA;" TextColor="{DynamicResource Danger}" />
                                <Label x:Name="ErrorLabel" Text="" FontAttributes="Bold" TextColor="{DynamicResource Danger}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Footer -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="28,16,28,24">
                    <BoxView Grid.ColumnSpan="3" HeightRequest="1" VerticalOptions="Start" Margin="-28,-16,-28,0"
                             Color="{DynamicResource Border}" />
                    <Label Text="* majburiy maydonlar" FontSize="12" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Bekor qilish" Style="{StaticResource SecondaryButton}" Clicked="OnCancel_Clicked" />
                    <Button Grid.Column="2" x:Name="SaveButton" Text="Saqlash" Style="{StaticResource PrimaryButton}"
                            MinimumWidthRequest="120" Clicked="OnSave_Clicked" />
                </Grid>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay" IsVisible="False" BackgroundColor="{DynamicResource Scrim}">
            <ActivityIndicator IsRunning="True" WidthRequest="48" HeightRequest="48"
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PasswordManager.Views.FileDrawer"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="24,20,20,0">
            <Label Text="SHIFRLANGAN FAYL" Style="{StaticResource Caps}" VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="&#xE711;"
                    Style="{StaticResource IconButton}"
                    BackgroundColor="{DynamicResource SurfaceMuted}"
                    Clicked="OnClose_Clicked"
                    ToolTipProperties.Text="Yopish" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,16,24,24" Spacing="18">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border x:Name="TileBorder" Style="{StaticResource Tile}"
                            WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 16">
                        <Label x:Name="BadgeLabel" FontSize="13" FontAttributes="Bold"
                               FontFamily="{StaticResource MonoFont}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label x:Name="NameLabel" Style="{StaticResource Heading}" FontSize="22"
                               LineBreakMode="CharacterWrap" MaxLines="2" />
                        <Label x:Name="MetaLabel" Style="{StaticResource Subheading}" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Button Text="Diskka saqlash"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnSave_Clicked">
                        <Button.ImageSource>
                            <FontImageSource Glyph="&#xE896;" FontFamily="{StaticResource IconFont}" Size="15" Color="White" />
                        </Button.ImageSource>
                    </Button>
                    <Button Grid.Column="1" Text="&#xE70F;" Style="{StaticResource IconButtonOutline}"
                            Clicked="OnEdit_Clicked" ToolTipProperties.Text="Nomi, izoh yoki faylni almashtirish" />
                    <Button Grid.Column="2" Text="&#xE74D;" Style="{StaticResource DangerIconButton}"
                            Clicked="OnDelete_Clicked" ToolTipProperties.Text="O'chirish" />
                </Grid>

                <!-- Integrity / encryption status -->
                <Border x:Name="StatusBox" StrokeShape="RoundRectangle 12" Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label x:Name="StatusGlyph" Style="{StaticResource Glyph}" Text="&#xE72E;" />
                        <Label x:Name="StatusLabel" Grid.Column="1" FontSize="13" FontAttributes="Bold"
                               VerticalOptions="Center" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>

                <!-- .env: one row per variable -->
                <VerticalStackLayout x:Name="EnvSection" IsVisible="False" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                        <Label x:Name="EnvTitleLabel" Text="O'zgaruvchilar" Style="{StaticResource FieldLabel}"
                               VerticalOptions="Center" Margin="0" />
                        <Button x:Name="EnvRevealButton" Grid.Column="1" Text="&#xE890;" Style="{StaticResource IconButton}"
                                Clicked="OnReveal_Clicked" ToolTipProperties.Text="Qiymatlarni ko'rsatish / yashirish" />
                        <Button Grid.Column="2" Text="&#xE8C8;" Style="{StaticResource IconButton}"
                                Clicked="OnCopyAll_Clicked" ToolTipProperties.Text="Butun faylni nusxalash" />
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="0" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout x:Name="EnvRows" />
                    </Border>
                </VerticalStackLayout>

                <!-- Other text files -->
                <VerticalStackLayout x:Name="TextSection" IsVisible="False" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                        <Label x:Name="TextTitleLabel" Text="Tarkib" Style="{StaticResource FieldLabel}"
                               VerticalOptions="Center" Margin="0" />
                        <Button x:Name="TextRevealButton" Grid.Column="1" Text="&#xE890;" Style="{StaticResource IconButton}"
                                Clicked="OnReveal_Clicked" ToolTipProperties.Text="Ko'rsatish / yashirish" />
                        <Button Grid.Column="2" Text="&#xE8C8;" Style="{StaticResource IconButton}"
                                Clicked="OnCopyAll_Clicked" ToolTipProperties.Text="Tarkibni nusxalash" />
                    </Grid>
                    <Border Style="{StaticResource Field}" Padding="14,12">
                        <ScrollView MaximumHeightRequest="320" Orientation="Both">
                            <Label x:Name="ContentLabel" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   LineBreakMode="NoWrap" />
                        </ScrollView>
                    </Border>
                </VerticalStackLayout>

                <!-- Binary -->
                <Border x:Name="BinarySection" IsVisible="False"
                        BackgroundColor="{DynamicResource SurfaceAlt}" Stroke="{DynamicResource Border}"
                        StrokeShape="RoundRectangle 12" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Style="{StaticResource Glyph}" Text="&#xE946;" />
                        <Label Grid.Column="1" Text="Bu fayl matn emas. Ko'rish uchun uni diskka saqlab, mos dasturda oching."
                               FontSize="13" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>

                <VerticalStackLayout x:Name="NoteSection" Spacing="0" IsVisible="False">
                    <Label Text="Izoh" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}" Padding="14,12">
                        <Label x:Name="NoteLabel" LineBreakMode="WordWrap" TextColor="{DynamicResource TextSecondary}" />
                    </Border>
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" Padding="16,4" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" HeightRequest="44">
                            <Label Text="Hajmi" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                            <Label x:Name="SizeLabel" Grid.Column="1" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
                        <Grid ColumnDefinitions="*,Auto" HeightRequest="44">
                            <Label Text="Qo'shilgan" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                            <Label x:Name="CreatedLabel" Grid.Column="1" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
                        <Grid ColumnDefinitions="*,Auto" HeightRequest="44">
                            <Label Text="O'zgartirilgan" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                            <Label x:Name="UpdatedLabel" Grid.Column="1" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
                        <Grid ColumnDefinitions="Auto,*" HeightRequest="44" ColumnSpacing="12">
                            <Label Text="Volume fayli" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                            <Label x:Name="BlobLabel" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   HorizontalOptions="End" VerticalOptions="Center" LineBreakMode="MiddleTruncation" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
